{
  "name": "gameevent-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Processamento assíncrono de resultados com NestJS, SNS, SQS e PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "start:api": "node dist/apps/api/main.js",
    "start:worker": "node dist/apps/worker/main.js",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/apps/api/main.js\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand",
    "migration:up": "mikro-orm migration:up",
    "migration:pending": "mikro-orm migration:pending",
    "migration:up:prod": "MIKRO_ORM_CLI_CONFIG=./dist/libs/database/mikro-orm.config.js MIKRO_ORM_CLI_PREFER_TS=false mikro-orm migration:up",
    "messaging:init": "node dist/docker/init-messaging.js",
    "demo": "node dist/scripts/demo.js",
    "demo:recovery": "node dist/scripts/recovery.js",
    "check:messaging": "node dist/scripts/check-messaging.js"
  },
  "mikro-orm": {
    "configPaths": [
      "./libs/database/mikro-orm.config.ts"
    ],
    "preferTs": true
  },
  "dependencies": {
    "@aws-sdk/client-sns": "3.1157.0",
    "@aws-sdk/client-sqs": "3.1157.0",
    "@mikro-orm/cli": "7.2.5",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/decorators": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@smithy/node-http-handler": "4.13.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/testing": "11.2.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "multer": "2.5.0",
    "js-yaml": "5.5.0"
  }
}
